# Variables de entorno de MiEmpleadApp — copiar a .env y ajustar.
# El archivo .env NO se commitea (ver .gitignore).

# Conexión a la base SQLite (ADR-002). En desarrollo, un archivo local.
# En producción, el archivo debe vivir en un VOLUMEN PERSISTENTE de Docker/Dokploy
# (Epic 9.1); de lo contrario los datos se pierden en cada redeploy. SQLite corre
# en modo WAL (habilitado por el cliente en src/lib/db.ts) para mejorar la
# concurrencia lectura/escritura en la instancia única.
DATABASE_URL="file:./dev.db"
